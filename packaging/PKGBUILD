# Builds and packages the checkout this file sits in (no source=(): the
# working tree as it is), for testing on a real system.
#   cd packaging && makepkg -sif
#   sudo pacman -R packageinstaller-manjaro-git
pkgname=packageinstaller-manjaro-git
pkgver=2.0.0
pkgrel=1
pkgdesc="CachyOS's package installer, for Manjaro: install, remove and update software, with AUR, Flatpak and AppImage"
arch=(x86_64)
url='https://github.com/CachyOS/packageinstaller'
license=(GPL-3.0-or-later)
# upstream's list, with the Manjaro logo (manjaro-icons, an SVG: qt6-svg) and
# pacman-mirrors in place of cachyos-rate-mirrors
depends=(appstream-qt archlinux-appstream-data elfutils glibc hicolor-icon-theme kimageformats
         libgcc libjxl libstdc++ manjaro-icons pacman pacman-mirrors polkit qt6-base qt6-declarative qt6-svg)
makedepends=(cmake git ninja qt6-tools vulkan-headers)
optdepends=('paru: build packages from the AUR (paru is itself in the AUR)'
            'git: review and build packages from the AUR'
            'flatpak: install Flatpak apps'
            'fuse2: start most AppImages'
            'pacman-contrib: see updates without refreshing the system databases')
provides=(packageinstaller-manjaro)
conflicts=(packageinstaller-manjaro)

_root=$(realpath "$startdir/..")
# NO_MANJARO_LOGO=1 makepkg -sif: a generic icon in place of the Manjaro logo
# (window, menu, sidebar, banner, password prompt); read by cmake/Manjaro.cmake

build() {
    # keep CPM's downloads of rapidyaml and backward-cpp in $srcdir
    export CPM_SOURCE_CACHE="$srcdir/cpm"
    # --fresh: makepkg -f keeps src/build, whose cache would win over -C
    cmake --fresh -C "$_root/cmake/Manjaro.cmake" -S "$_root" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=ON
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure --no-tests=error
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$_root/THIRD-PARTY.md" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY.md"
}
